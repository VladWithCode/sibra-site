# Frontend (Vite) environment variables.
# Copy to `frontend/.env` and fill in. Only vars prefixed with VITE_ are exposed
# to the client bundle. Restart the dev server after editing.

# Google Maps JavaScript API key. Required for the property location maps
# (public detail page) and the geocoder in the dashboard location section.
# Without it, <APIProvider> is skipped and <Map> throws
# "can only be used inside an <ApiProvider>".
VITE_MAPS_API_KEY=

# Google Maps "Map ID" (cloud-based map style). Needed for AdvancedMarker / Pin
# to render on the map. Create one in Google Cloud Console > Map Management.
VITE_MAPS_PROPERTY_LOCATION_ID=
